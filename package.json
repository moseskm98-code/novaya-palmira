{
  "name": "site-hono",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun --watch src/server.tsx",
    "build": "bun build src/client.tsx --outdir dist/assets --target browser --minify --external \"/fonts/*\"",
    "build:pages": "bun scripts/export-pages.ts",
    "start": "bun src/server.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/app.test.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "hono": "^4.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
